# Hostinger 站点配置（复制为 .env.hostinger 并填写；.env.hostinger 已被 gitignore）
# 站点地址（带 https://，结尾不要斜杠）
WP_URL=https://your-domain.com

# WordPress 后台用户名 + 应用密码
# 应用密码生成：后台 → Users → Profile → Application Passwords → Add New
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 以下仅在使用 WooCommerce 产品接口时需要
# 生成：WooCommerce → Settings → Advanced → REST API → Create an API key
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
